# Copiar a .env y ajustar. El .env real NO se versiona.

PORT=3000
HOST=0.0.0.0

# Postgres. En Railway la inyecta el servicio de base referenciando la red
# privada: DATABASE_URL=${{Postgres.DATABASE_URL}}
# En local, una base propia:
#   createdb sgo   (o docker run -e POSTGRES_PASSWORD=... -p 5432:5432 postgres:17)
DATABASE_URL=postgres://localhost:5432/sgo

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

NODE_ENV=development

# ---------------------------------------------------------------------------
# Backup diario a Cloudflare R2 (opcional en local; recomendado en producción).
# Sin las cuatro credenciales, el backup queda apagado y la app funciona igual.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Carpeta dentro del bucket. Default: sgo/
R2_PREFIX=sgo/

# Apagar el backup aun teniendo credenciales: BACKUP_ENABLED=false
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
